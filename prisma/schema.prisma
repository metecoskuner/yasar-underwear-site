generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Use SQLite for local development to make migrations easier locally.
  // If you use Postgres in production, set the DATABASE_URL accordingly
  // and change the provider back to "postgresql".
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  product   String?
  qty       Int
  message   String?
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
}
