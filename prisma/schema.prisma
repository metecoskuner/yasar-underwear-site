generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Use the DATABASE_URL environment variable to choose the database.
  // For production we use Postgres (Supabase). Ensure DATABASE_URL points
  // to your Postgres instance and set `provider = "postgresql"` here
  // before running migrations in that environment.
  // Use sqlite for local development fallback. Change back to "postgresql"
  // for production deployments where DATABASE_URL points to Postgres.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  product   String?
  qty       Int
  message   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Product {
  id         String   @id @default(cuid())
  title      String
  description String?
  productCode String
  gender     String
  // For local sqlite fallback we store images as a JSON string.
  // In production (Postgres) you may want to use `Json` instead.
  images     String
  stock      Int      @default(0)
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model SiteContent {
  id        String @id @default(cuid())
  key       String @unique
  // For sqlite fallback we store site JSON as a string.
  value     String
  updatedAt DateTime @updatedAt
}

model HoneypotLog {
  id             String   @id @default(cuid())
  ip             String
  userAgent      String?
  submittedValue String?
  createdAt      DateTime @default(now())
}
