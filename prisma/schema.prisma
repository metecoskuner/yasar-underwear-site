generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Default to SQLite for local development. For production with Postgres,
  // change `provider` to "postgresql" on the deploy environment before
  // running migrations (Prisma does not accept an env() value for provider).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  product   String?
  qty       Int
  message   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
}
